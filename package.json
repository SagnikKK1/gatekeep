{
  "name": "gatekeep-agent",
  "version": "0.1.0",
  "description": "Independent verification gate for AI coding agents: blocks the agent from declaring done when it tampered with tests.",
  "type": "module",
  "bin": {
    "gatekeep": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "action.yml",
    "scripts/annotate.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "gatekeep": "node dist/src/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@vscode/tree-sitter-wasm": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SagnikKK1/gatekeep.git"
  },
  "homepage": "https://github.com/SagnikKK1/gatekeep#readme",
  "bugs": {
    "url": "https://github.com/SagnikKK1/gatekeep/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "testing",
    "verification",
    "reward-hacking",
    "git-hooks",
    "tree-sitter"
  ],
  "author": "Sagnik Dey <sagnik1.dey.official@gmail.com>"
}
